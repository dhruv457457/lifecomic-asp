OPENROUTER_API_KEY=

# Model selection (OpenRouter model slugs)
LIFECOMIC_LLM_MODEL=google/gemini-2.5-flash
LIFECOMIC_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# Server
PORT=4020
BASE_URL=http://localhost:4020

# Durable file storage (optional). When set, generated pages/PDFs upload to Cloudinary and the API
# returns CDN URLs that survive Railway redeploys. Unset = files served from (ephemeral) local disk.
# Copy the "API environment variable" from your Cloudinary dashboard (cloudinary://KEY:SECRET@CLOUD).
CLOUDINARY_URL=

# OKX x402 payment (from your OKX Web3 / Agentic Wallet)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
OKX_SYNC_SETTLE=true
PAY_TO_ADDRESS=
X402_NETWORK=eip155:196
X402_STORYBOARD_PRICE=$0.02
X402_COMIC_PRICE=$0.15
X402_BOOK_PRICE=$0.80
